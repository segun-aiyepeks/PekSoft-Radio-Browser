generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum EntitlementTier {
  FREE
  PLUS
}

enum EntitlementStatus {
  ACTIVE
  GRACE
  EXPIRED
  CANCELLED
}

enum EntitlementSource {
  NONE
  GOOGLE_PLAY
  PAYSTACK
  PROMO
}

enum ReportReason {
  DEAD_STREAM
  WRONG_INFO
  OFFENSIVE
  OTHER
}

enum ReportStatus {
  OPEN
  REVIEWED
  RESOLVED
}

model User {
  id          String   @id @default(uuid()) @db.Uuid
  firebaseUid String   @unique @map("firebase_uid")
  email       String?  @unique
  displayName String?  @map("display_name")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  favorites      Favorite[]
  collections    Collection[]
  recents        Recent[]
  songHistory    SongHistory[]
  entitlement    Entitlement?
  stationReports StationReport[]

  @@map("users")
}

model Favorite {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  stationId   String   @map("station_id")
  stationName String   @map("station_name")
  streamUrl   String   @map("stream_url")
  countryCode String   @default("") @map("country_code")
  faviconUrl  String?  @map("favicon_url")
  codec       String?
  bitrateKbps Int?     @map("bitrate_kbps")
  isDeleted   Boolean  @default(false) @map("is_deleted")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, stationId])
  @@index([userId, updatedAt])
  @@map("favorites")
}

model Collection {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  name        String
  description String?
  isDeleted   Boolean  @default(false) @map("is_deleted")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user  User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CollectionItem[]

  @@index([userId, updatedAt])
  @@map("collections")
}

model CollectionItem {
  id           String   @id @default(uuid()) @db.Uuid
  collectionId String   @map("collection_id") @db.Uuid
  stationId    String   @map("station_id")
  stationName  String   @map("station_name")
  streamUrl    String   @map("stream_url")
  countryCode  String   @default("") @map("country_code")
  position     Int      @default(0)
  isDeleted    Boolean  @default(false) @map("is_deleted")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@unique([collectionId, stationId])
  @@index([collectionId, position])
  @@index([collectionId, updatedAt])
  @@map("collection_items")
}

model Recent {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  stationId   String   @map("station_id")
  stationName String   @map("station_name")
  streamUrl   String   @map("stream_url")
  countryCode String   @default("") @map("country_code")
  playedAt    DateTime @default(now()) @map("played_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, stationId])
  @@index([userId, playedAt(sort: Desc)])
  @@index([userId, updatedAt])
  @@map("recents")
}

model SongHistory {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  stationId   String   @map("station_id")
  stationName String   @map("station_name")
  trackTitle  String   @map("track_title")
  heardAt     DateTime @default(now()) @map("heard_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, heardAt(sort: Desc)])
  @@index([userId, updatedAt])
  @@map("song_history")
}

model Entitlement {
  id                     String            @id @default(uuid()) @db.Uuid
  userId                 String            @unique @map("user_id") @db.Uuid
  tier                   EntitlementTier   @default(FREE)
  status                 EntitlementStatus @default(ACTIVE)
  source                 EntitlementSource @default(NONE)
  externalCustomerId     String?           @map("external_customer_id")
  externalSubscriptionId String?           @map("external_subscription_id")
  expiresAt              DateTime?         @map("expires_at")
  createdAt              DateTime          @default(now()) @map("created_at")
  updatedAt              DateTime          @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, expiresAt])
  @@map("entitlements")
}

model WebhookEvent {
  id          String    @id @default(uuid()) @db.Uuid
  provider    String
  eventId     String    @map("event_id")
  eventType   String    @map("event_type")
  payload     Json
  processedAt DateTime? @map("processed_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@unique([provider, eventId])
  @@index([provider, createdAt])
  @@map("webhook_events")
}

model StationReport {
  id          String       @id @default(uuid()) @db.Uuid
  userId      String?      @map("user_id") @db.Uuid
  stationId   String       @map("station_id")
  stationName String       @map("station_name")
  reason      ReportReason
  notes       String?
  status      ReportStatus @default(OPEN)
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([stationId, status])
  @@index([createdAt])
  @@map("station_reports")
}
