# Server
PORT=4000
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info
APP_VERSION=0.1.0

# Comma-separated allowed browser origins, or * in local development
CORS_ORIGINS=http://localhost:3000

# Rate limiting (requests per window)
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_MS=60000

# PostgreSQL connection string (Prisma)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/peksoft_radio?schema=public

# Firebase Admin SDK (service account credentials)
FIREBASE_PROJECT_ID=peksoft-radio-dev
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@peksoft-radio-dev.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
